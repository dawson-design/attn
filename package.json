{
  "name": "ghe-notification-watch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local read-only GitHub Enterprise notification dashboard (configurable host).",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port ${GHE_WATCH_PORT:-8765}",
    "start": "vite --host 127.0.0.1 --port ${GHE_WATCH_PORT:-8765}",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port ${GHE_WATCH_PORT:-8765}",
    "serve": "HOST=127.0.0.1 PORT=${GHE_WATCH_PORT:-8765} bun build/index.js",
    "watch": "bun src/cli/watch.ts",
    "cli": "bun src/cli/main.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test",
    "coverage": "bun test --coverage",
    "typecheck": "svelte-kit sync && bun --bun tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:shell": "shellcheck -x scripts/*.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "bun run format:check && bun run lint && bun run lint:shell && bun run typecheck && bun test"
  },
  "dependencies": {
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/kit": "^2.70.2",
    "bits-ui": "^2.16.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-svelte": "^0.468.0",
    "svelte": "^5.15.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.17.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/bun": "^1.2.0",
    "eslint": "^10.8.0",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "shadcn-svelte": "^1.3.0",
    "svelte-check": "^4.1.0",
    "tailwind-variants": "^3.2.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0"
  }
}
